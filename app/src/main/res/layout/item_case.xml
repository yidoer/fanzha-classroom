<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3" android:background="@drawable/bg_card_clickable"
    android:clickable="true" android:focusable="true" android:elevation="1dp"
    android:stateListAnimator="@animator/card_lift"
    android:orientation="vertical" android:padding="@dimen/space_4">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/category" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_chip" android:maxLines="1"
            android:paddingStart="@dimen/space_3" android:paddingTop="@dimen/space_1" android:paddingEnd="@dimen/space_3" android:paddingBottom="@dimen/space_1"
            android:textColor="@color/brand" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/clearedBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:background="@drawable/bg_chip_done" android:maxLines="1"
            android:paddingStart="8dp" android:paddingTop="5dp" android:paddingEnd="8dp" android:paddingBottom="5dp"
            android:text="@string/badge_cleared" android:textColor="@color/state_safe" android:textSize="11sp" android:textStyle="bold"
            android:visibility="gone" />
        <TextView android:id="@+id/risk" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="end" android:maxLines="1" android:textColor="@color/text_tertiary" android:textSize="12sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/favoriteButton" android:layout_width="@dimen/touch_min" android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/space_1" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/favorite_story" android:padding="@dimen/space_3" android:src="@drawable/ic_bookmark" />
    </LinearLayout>
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2" android:ellipsize="end" android:maxLines="2" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:ellipsize="end" android:lineSpacingMultiplier="1.45" android:maxLines="3"
        android:textColor="@color/text_secondary" android:textSize="15sp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="@dimen/space_3" android:background="@color/border_subtle" />
    <TextView android:id="@+id/source" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3" android:ellipsize="end"
        android:maxLines="1" android:textColor="@color/text_tertiary" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
