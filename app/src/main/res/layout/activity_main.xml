<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:fitsSystemWindows="true"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_header" android:orientation="vertical"
        android:paddingStart="20dp" android:paddingTop="10dp" android:paddingEnd="12dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/headerTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="防诈课堂" android:textColor="@color/ink" android:textSize="24sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/checkUpdates" style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp" android:layout_height="42dp" android:contentDescription="更新中心"
                app:icon="@drawable/ic_update" app:iconGravity="textStart" app:iconPadding="0dp" />
        </LinearLayout>
        <TextView android:id="@+id/headerSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text="真假不预告，练习有边界的信任" android:textColor="@color/muted" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/libraryControls" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp">
        <EditText android:id="@+id/searchInput" android:layout_width="match_parent" android:layout_height="42dp"
            android:background="@drawable/bg_search" android:hint="搜索故事、人物或情境"
            android:inputType="text" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textSize="15sp" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:scrollbars="none">
            <LinearLayout android:id="@+id/categoryContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>
        <TextView android:id="@+id/resultCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="@color/muted" android:textSize="13sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/caseList"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:padding="14dp" />

    <ScrollView android:id="@+id/infoScroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:visibility="gone">
        <LinearLayout android:id="@+id/infoContent" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" />
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/surface"
        android:elevation="6dp" android:orientation="horizontal" android:padding="4dp">
        <Button android:id="@+id/navCases" style="@style/NavButton" android:drawableTop="@drawable/ic_library" android:drawablePadding="3dp" android:text="故事" />
        <Button android:id="@+id/navFavorites" style="@style/NavButton" android:drawableTop="@drawable/ic_bookmark" android:drawablePadding="3dp" android:text="收藏" />
        <Button android:id="@+id/navEmergency" style="@style/NavButton" android:drawableTop="@drawable/ic_emergency" android:drawablePadding="3dp" android:text="止损" />
    </LinearLayout>
</LinearLayout>
