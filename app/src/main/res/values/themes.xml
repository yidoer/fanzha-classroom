<resources>
    <style name="Theme.FanZha" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/text_on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_subtle</item>
        <item name="colorSecondary">@color/warning</item>
        <item name="colorError">@color/danger</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorSurfaceVariant">@color/bg_elevated</item>
        <item name="android:statusBarColor">@color/surface_warm</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface_warm</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:letterSpacing">0</item>
        <item name="shapeAppearanceCornerExtraSmall">@dimen/radius_card</item>
        <item name="shapeAppearanceCornerSmall">@dimen/radius_card</item>
    </style>

    <style name="NavDockButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="iconPadding">0dp</item>


    </style>


</resources>
